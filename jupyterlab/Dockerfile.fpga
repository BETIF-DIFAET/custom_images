FROM almalinux:9.8

ARG XRT_RPM=xrt_202620.2.26.0_9.8-x86_64-xrt.rpm
ARG XRT_VERSION=2.26.0
ARG KERNEL_VERSION=5.14.0-687.20.1.el9_8.x86_64

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Keep all RPM/DNF mutations in one layer. BuildKit bind mounts prevent the
# local XRT RPM and package list from becoming permanent COPY layers.
RUN --mount=type=bind,source=${XRT_RPM},target=/tmp/${XRT_RPM},readonly \
    --mount=type=bind,source=packages,target=/tmp/packages,readonly \
    set -eux; \
    dnf install -y dnf-plugins-core; \
    dnf config-manager --set-enabled crb; \
    dnf install -y \
        epel-release \
        python39 \
        python3-pip \
        python3-devel \
        boost-python3 \
        jq \
        procps; \
    dnf install -y https://repo.osg-htc.org/osg/25-main/osg-25-main-el9-release-latest.rpm; \
    curl -fsSL \
        https://software.igwn.org/lscsoft/rocky/9/production/x86_64/os/Packages/i/igwn-production-config-9-5.el9.noarch.rpm \
        -o /tmp/igwn-production-config.rpm; \
    dnf install -y /tmp/igwn-production-config.rpm; \
    rm -f /tmp/igwn-production-config.rpm; \
    dnf install -y \
        htgettoken \
        python3-igwn-auth-utils \
        gwdatafind \
        pelican; \
    xargs -r dnf -y install < /tmp/packages; \
    dnf install -y \
        dkms \
        perl \
        patch \
        sed \
        findutils \
        elfutils-libelf-devel \
        openssl-devel \
        kernel-headers \
        "kernel-devel-${KERNEL_VERSION}" \
        "/tmp/${XRT_RPM}"; \
    SOURCE_FILE="/usr/src/xrt-${XRT_VERSION}/driver/xocl/lib/libqdma/QDMA/linux-kernel/driver/libqdma/qdma_mbox.c"; \
    test -f "${SOURCE_FILE}"; \
    if grep -Fq 'from_timer(mbox, t, timer);' "${SOURCE_FILE}"; then \
        sed -i \
            's/from_timer(mbox, t, timer);/container_of(t, struct qdma_mbox, timer);/' \
            "${SOURCE_FILE}"; \
    fi; \
    grep -Fq 'container_of(t, struct qdma_mbox, timer);' "${SOURCE_FILE}"; \
    mkdir -p "/lib/modules/${KERNEL_VERSION}"; \
    ln -sfn "/usr/src/kernels/${KERNEL_VERSION}" "/lib/modules/${KERNEL_VERSION}/build"; \
    ln -sfn "/usr/src/kernels/${KERNEL_VERSION}" "/lib/modules/${KERNEL_VERSION}/source"; \
    dkms remove -m xrt -v "${XRT_VERSION}" --all || true; \
    dkms add -m xrt -v "${XRT_VERSION}"; \
    dkms build -m xrt -v "${XRT_VERSION}" -k "${KERNEL_VERSION}"; \
    dkms install -m xrt -v "${XRT_VERSION}" -k "${KERNEL_VERSION}"; \
    mkdir -p /tmp/xilinx-platforms; \
    cd /tmp/xilinx-platforms; \
    curl -fsSLO https://download.amd.com/opendownload/xlnx/xilinx-u55c-gen3x16-xdma_2024.1_2024_0522_2343-noarch.rpm.tar.gz; \
    curl -fsSLO https://download.amd.com/opendownload/xlnx/xilinx-u250-gen3x16-xdma_2024.1_2024_0522_2343-noarch.rpm.tar.gz; \
    tar -xzf xilinx-u55c-gen3x16-xdma_2024.1_2024_0522_2343-noarch.rpm.tar.gz; \
    tar -xzf xilinx-u250-gen3x16-xdma_2024.1_2024_0522_2343-noarch.rpm.tar.gz; \
    rm -f ./*.tar.gz; \
    dnf install -y ./xilinx-*; \
    dnf install -y voms-clients-cpp; \
    cd /; \
    rm -rf /tmp/xilinx-platforms; \
    dnf clean all; \
    rm -rf /var/cache/dnf

WORKDIR /

ENV CONDA_DIR=/opt/conda
ENV PATH=${CONDA_DIR}/bin:${PATH}

# Install Miniconda, resolve the complete environment once, install pip
# packages, and purge installer/package caches before this layer is committed.
RUN set -eux; \
    curl -fsSL \
        https://repo.anaconda.com/miniconda/Miniconda3-py311_25.3.1-1-Linux-x86_64.sh \
        -o /tmp/miniconda.sh; \
    /bin/bash /tmp/miniconda.sh -b -p "${CONDA_DIR}"; \
    rm -f /tmp/miniconda.sh; \
    conda install -y -c conda-forge \
        python==3.11.13 \
        jupyterlab==4.5.2 \
        nodejs==20.9.0 \
        jupyterhub==5.4.3 \
        davix==0.8.6 \
        xrootd==5.5.5 \
        gfal2==2.21.3 \
        gfal2-util==1.9.0 \
        python-gfal2==1.12.0 \
        apptainer==1.4.4; \
    python -m pip install --no-cache-dir \
        rucio==41.1.1 \
        rucio-clients==41.1.1 \
        rucio-jupyterlab==41.0.0 \
        ksmm==1.0.0; \
    conda clean -afy

ENV TINI_VERSION=v0.19.0
RUN curl -fsSL \
        "https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini" \
        -o /bin/tini \
    && chmod 0755 /bin/tini

RUN mkdir -p /root/.ipython /root/.init

COPY --chmod=0755 ./jupyterhub-singleuser.sh /usr/local/bin/jupyterhub-singleuser.sh
COPY --chmod=0755 ./jupyterhub-singleuser /usr/local/bin/jupyterhub-singleuser
COPY --chmod=0755 ./spawn.sh /root/.init/spawn.sh

RUN ln -sfn /cvmfs/grid.cern.ch/etc/grid-security/vomses/ /etc/vomses \
    && rm -rf /etc/grid-security/vomsdir \
    && mkdir -p /etc/grid-security \
    && ln -sfn /cvmfs/grid.cern.ch/etc/grid-security/vomsdir/ /etc/grid-security/vomsdir \
    && ln -sfn /cvmfs/grid.cern.ch/etc/grid-security/certificates/ /etc/grid-security/certificates

COPY ./config/jupyter_notebook_config.json /opt/conda/etc/jupyter/jupyter_notebook_config.json

COPY ./singularity-kernel/ /opt/conda/share/jupyter/kernels/singularity-kernel/
COPY ./singularity-kernel-ROOT/ /opt/conda/share/jupyter/kernels/singularity-kernel-ROOT/
COPY ./singularity-kernel-wdf/ /opt/conda/share/jupyter/kernels/singularity-kernel-wdf/
COPY ./singularity-kernel-igwn/ /opt/conda/share/jupyter/kernels/singularity-kernel-igwn/
RUN jupyter kernelspec install /opt/conda/share/jupyter/kernels/singularity-kernel/ \
    && jupyter kernelspec install /opt/conda/share/jupyter/kernels/singularity-kernel-ROOT/ \
    && jupyter kernelspec install /opt/conda/share/jupyter/kernels/singularity-kernel-wdf/ \
    && jupyter kernelspec install /opt/conda/share/jupyter/kernels/singularity-kernel-igwn/

COPY ./config/rucio.cfg /opt/rucio/etc/rucio.cfg

WORKDIR /opt/workspace
